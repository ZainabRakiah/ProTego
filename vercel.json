{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "web/dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "{safety_route/backend/safety_model.pkl,safety_route/data1/ProTego.csv,safety_route/data1/bangalore_hospitals.csv,data/ProTego.csv,data/bangalore_hospitals.csv,FriendsNavigator/**}"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/safecam(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/data(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/friendsnavigator(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
